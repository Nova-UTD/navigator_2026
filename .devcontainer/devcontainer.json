// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/docker-existing-docker-compose
{
    "name": "Navigator 2026",
    "dockerComposeFile": [
        "../docker-compose.yml"
    ],
    // The name of the service for the container that VS Code should
    // use.
    "service": "navigator_carla",
    // The path path VS Code should open by default when connected.
    "workspaceFolder": "/navigator",
    // Specific services to start.
    "runServices": [
        "navigator_carla"
    ],
    // Runs on the host before connecting: find a working X display for RViz (written to .x11/).
    "initializeCommand": "docker/x11.sh",
    // Pass a command so entrypoint.sh exits instead of `exec bash` (which never returns and hangs the attach).
    // Uses the repo's copy so changes apply without rebuilding the image.
    "postAttachCommand": "bash /navigator/docker/entrypoint.sh true",
    // Configure tool-specific properties.
    "customizations": {
        "vscode": {
            "settings": {
                "files.saveConflictResolution": "overwriteFileOnDisk",
                "editor.formatOnSave": true,
                "[python]": {
                    "editor.defaultFormatter": "ms-python.black-formatter"
                }
            },
            "extensions": [
                "ms-iot.vscode-ros",
                "ms-python.black-formatter",
                "ms-azuretools.vscode-docker",
                "eamodio.gitlens",
                "ms-vscode.cpptools-extension-pack"
            ]
        }
    }
}