<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lane_map</name>
  <version>0.1.0</version>
  <description>Loads any OpenDRIVE map as a network of lanes: the car's GPS and rulebook</description>
  <maintainer email="project.nova@utdallas.edu">Nova</maintainer>
  <license>MIT License</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>boost</depend>
  <depend>carla_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>libopendrive</depend>
  <depend>rclcpp</depend>
  <depend>visualization_msgs</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
